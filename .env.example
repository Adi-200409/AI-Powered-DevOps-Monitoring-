# ==============================================================
# AI-Powered DevOps Monitoring - Environment Configuration
# ==============================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# --- Groq AI Configuration ---
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Slack Integration ---
# Create an Incoming Webhook in your Slack workspace (#devops-alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#devops-alerts

# --- Application Configuration ---
APP_HOST=0.0.0.0
APP_PORT=5000
MONGO_URI=mongodb://localhost:27017/devops_db
LOG_FILE_PATH=logs/application.log

# --- Dashboard Configuration ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5050

# --- AWS & Deployment Configuration ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_REPOSITORY_NAME=ai-devops-app
ECR_REGISTRY_URL=123456789012.dkr.ecr.us-east-1.amazonaws.com
EC2_HOST=ec2-xx-xx-xx-xx.compute-1.amazonaws.com

