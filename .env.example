# ==============================================================
# AI-Powered DevOps Monitoring - Environment Configuration
# Tech Stack: React, FastAPI, Python, PostgreSQL, Docker, Jenkins
# ==============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Groq AI Configuration ---
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Slack Integration ---
# Create an Incoming Webhook in your Slack workspace (#devops-alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#devops-alerts

# --- Approved Remediation Runner (disabled by default) ---
# Configure a trusted runbook receiver before enabling actions in the dashboard.
REMEDIATION_ENABLED=false
REMEDIATION_WEBHOOK_URL=

# --- Application Configuration (FastAPI) ---
APP_HOST=0.0.0.0
APP_PORT=5000
LOG_FILE_PATH=logs/application.log
# Optional comma-separated Docker container names for cross-service error correlation.
MONITORED_CONTAINERS=

# --- PostgreSQL Database Configuration ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=devops_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devops_db

# --- Central Dashboard Configuration (React + FastAPI) ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5050
VITE_API_URL=http://localhost:5050

# --- AWS & Jenkins CI/CD Configuration ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_REPOSITORY_NAME=ai-devops-app
ECR_REGISTRY_URL=123456789012.dkr.ecr.us-east-1.amazonaws.com
EC2_HOST=ec2-xx-xx-xx-xx.compute-1.amazonaws.com
